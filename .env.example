# Copy to .env and fill in. Never commit the result.

# Akash Console API key. Can provision and close deployments and spend from
# escrow — and closing a lease destroys that deployment's persistent volume.
# console.akash.network/user/api-keys
AKASH_API_KEY=

# The deployment bin/deploy.sh updates: the validator, earth-1's one node
# (also the full-history RPC behind rpc/lcd.erth.network).
DSEQ=

# Cloudflare Tunnel token for the chain tunnel (one tunnel per deployment).
# The long eyJ... from the tunnel's install command, not the tunnel UUID.
TUNNEL_TOKEN=

# The genesis validator's consensus key (priv_validator_key.json, base64) — the
# key that can double-sign — and its p2p node key (node_key.json, base64), which
# fixes the node id peers dial. Injected only by --validator-key / --node-key.
PRIV_VALIDATOR_KEY_B64=
NODE_KEY_B64=

# The genesis validator's operator account (earth1n6amvkgfrrgy6ulhurewnm0endkgye69fkcapr
# for the relaunch). Signs the gentx at the ceremony and the operator's txs after
# launch (funding the gas wallet, governance), from the operator's machine. Never
# sent to a lease built with --fullnode.
VALIDATOR_MNEMONIC=

# IBC relayer key. Not injected by any build build-sdl.py accepts today (the
# relayer is off; see akash/README.md). Pays gas on both chains and holds nothing else, so the
# failure mode is delayed packets rather than theft. Note that an
# Ethereum-style counterparty derives a DIFFERENT address from the same words —
# coin type 60 rather than 118 — so fund the one the relayer logs print.
RELAYER_MNEMONIC=
